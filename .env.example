# ---------------------------------------------------------------------------
# Together — environment configuration
#
# EVERY variable here is OPTIONAL. With an empty .env.local the app runs in
# "local mode": rooms, realtime sync, saved memories, letters, gifts and the
# scrapbook all work using the browser (BroadcastChannel + localStorage), so
# you can test the whole product on one machine across two browser tabs.
#
# Fill these in to switch on the hosted, cross-device backend.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# RAILWAY BACKEND (the migration target)
# ---------------------------------------------------------------------------
# Set NEXT_PUBLIC_WS_URL and the app uses Railway. Leave it empty and it uses
# Supabase if configured, otherwise the browser-only local mode. There is no
# fallback between them at runtime: a Railway deployment that cannot reach its
# realtime server fails loudly rather than quietly giving each player a private
# room on their own machine.

# --- Database --------------------------------------------------------------
# Railway injects this for a Postgres service. Point it at the restricted
# `together_app` role from db/role.sql, not at the superuser.
# SERVER-ONLY. Never prefix with NEXT_PUBLIC_.
DATABASE_URL=

# The migration runner needs DDL, which together_app deliberately lacks. Set
# this to the owner connection string for the deploy step only.
MIGRATE_DATABASE_URL=

# --- Sessions --------------------------------------------------------------
# Signs the anonymous guest session cookie. 32+ characters.
#   openssl rand -hex 32
# SERVER-ONLY. Rotating it signs every guest out of every room, so set
# SESSION_SECRET_PREVIOUS to the old value for one deploy to avoid that.
SESSION_SECRET=
SESSION_SECRET_PREVIOUS=

# --- Realtime --------------------------------------------------------------
# Where the browser opens its WebSocket. Public by nature — it is a URL.
#   wss://<your-app>.up.railway.app/ws
NEXT_PUBLIC_WS_URL=

# --- Object storage (Photobooth and Snap Hunt photos) ----------------------
# Cloudflare R2. The bucket must be PRIVATE with no public access: every read
# and write goes through a URL the server signs for one object.
# ALL FOUR ARE SERVER-ONLY. None may ever be prefixed with NEXT_PUBLIC_.
# Without them, media falls back to on-disk storage in the app container, which
# is fine for local development and not for production.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Optional. Signs local-storage URLs when R2 is not configured; falls back to
# SESSION_SECRET. Only used by the local adapter.
STORAGE_SIGNING_SECRET=

# Optional. Where the local adapter writes. Defaults to a temp directory.
LOCAL_STORAGE_DIR=

# ---------------------------------------------------------------------------
# SUPABASE (the current backend — kept until the Railway path is proven)
# ---------------------------------------------------------------------------

# --- Supabase (rooms, realtime, auth, storage) -----------------------------
# Create a project at https://supabase.com, then:
#   Project Settings -> API -> Project URL          => NEXT_PUBLIC_SUPABASE_URL
#   Project Settings -> API -> anon / public key    => NEXT_PUBLIC_SUPABASE_ANON_KEY
# Then run supabase/schema.sql in the SQL editor.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only key. Never prefix with NEXT_PUBLIC_. Only needed if you later add
# privileged server routes (scheduled letter delivery, moderation, etc).
SUPABASE_SERVICE_ROLE_KEY=

# --- AI judging (Debate + Couples Court) -----------------------------------
# Server-side only; it is read inside app/api/judge/route.ts and never shipped
# to the browser. Without it both features use a deterministic offline judge.
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Email delivery for Letters --------------------------------------------
# Without this, letters are stored and shown as "scheduled" inside the app and
# unseal on their delivery date. No mail is ever sent.
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=

# --- Public site URL (invite links, QR codes, OpenGraph) -------------------
# Defaults to the browser's current origin when unset.
NEXT_PUBLIC_SITE_URL=
