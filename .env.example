# ---------------------------------------------------------------------------
# Together — environment configuration
#
# Placeholders only. Never commit real values: put them in .env.local, which is
# git-ignored, or in Railway's variable settings.
#
# EVERY variable here is OPTIONAL. With an empty .env.local the app runs in
# "local mode": rooms, realtime sync, saved memories, letters, gifts and the
# scrapbook all work using the browser (BroadcastChannel + localStorage), so you
# can test the whole product on one machine across two browser tabs.
#
# Grouped by where each value is allowed to go. The grouping is the point:
# anything under SERVER-ONLY that acquires a NEXT_PUBLIC_ prefix is shipped to
# every visitor, and `npm run check:db` fails the build for exactly that.
# ---------------------------------------------------------------------------


# ===========================================================================
# 1. PUBLIC — compiled into the browser bundle, readable by anyone
# ===========================================================================
# A NEXT_PUBLIC_ prefix means "print this in the page source". Only ever put
# values here that you would be happy to publish, because you are publishing
# them.

# Where the browser opens its WebSocket. Setting this is what switches the app
# to the Railway backend; leave it empty for local mode.
#   wss://<your-app>.up.railway.app/ws
# Must be wss:// in production — the app refuses to start on ws://.
NEXT_PUBLIC_WS_URL=

# Invite links, QR codes, OpenGraph. Defaults to the browser's origin.
#   https://<your-app>.up.railway.app
NEXT_PUBLIC_SITE_URL=


# ===========================================================================
# 2. SESSION / JWT — SERVER-ONLY
# ===========================================================================
# Signs the anonymous guest session cookie. Whoever holds this can mint a
# session for any guest.

# 32 characters minimum; the app refuses to start on less.
#   openssl rand -hex 32
SESSION_SECRET=

# Set to the OLD secret for one deploy after rotating, so sessions signed with
# it still verify. Without this, rotating signs every guest out of every room.
# Remove it on the following deploy.
SESSION_SECRET_PREVIOUS=


# ===========================================================================
# 3. DATABASE — SERVER-ONLY
# ===========================================================================

# The connection the application serves traffic on. Point this at the
# restricted `together_app` role created by db/role.sql — NOT at the superuser
# Railway gives you. In production the app checks, and refuses to start on a
# privileged connection.
DATABASE_URL=

# The owner connection, used only to run migrations on boot. `together_app`
# deliberately cannot run DDL, so without this the migration step fails.
MIGRATE_DATABASE_URL=

# Connections in the pool. Leave unset (default 10) unless the Postgres plan
# has a low connection limit and several instances are running.
PGPOOL_MAX=


# ===========================================================================
# 4. OBJECT STORAGE (Photobooth and Snap Hunt photos) — SERVER-ONLY
# ===========================================================================
# Cloudflare R2. The bucket must be PRIVATE with no public access: every read
# and write goes through a URL the server signs for one object.
#
# All four are required together — the app refuses to start with some but not
# all of them. Without any, media falls back to on-disk storage in the app
# container, which is fine locally and NOT for production: Railway containers
# have ephemeral disks and every photo is lost on the next deploy.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Signs local-storage URLs when R2 is not configured. Falls back to
# SESSION_SECRET. Only the local adapter uses it.
STORAGE_SIGNING_SECRET=

# Where the local adapter writes. Defaults to a temp directory.
LOCAL_STORAGE_DIR=


# ===========================================================================
# 5. OTHER SERVER-ONLY SERVICES
# ===========================================================================

# AI judging for Debate and Couples Court. Read inside app/api/judge/route.ts
# and never shipped to the browser. Without it, both features use a
# deterministic offline judge and work fine.
#   https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Email delivery for Letters. Without these, letters are stored and shown as
# "scheduled" inside the app and unseal on their delivery date. No mail is sent.
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=


# ===========================================================================
# 6. RAILWAY / RUNTIME
# ===========================================================================

# Railway sets PORT itself; the server binds it. Do not set it manually.
# HOSTNAME defaults to 0.0.0.0, which is what a container needs.
PORT=
HOSTNAME=

# Logging. Structured JSON in production, readable lines otherwise.
#   LOG_LEVEL:  debug | info | warn | error   (default info)
#   LOG_FORMAT: json                          (forces JSON outside production)
LOG_LEVEL=
LOG_FORMAT=

# How long a SIGTERM shutdown may take before the process exits anyway.
# Default 10000ms. Railway allows roughly 30 seconds.
SHUTDOWN_TIMEOUT_MS=

# Ceiling on paid model calls per minute across all callers. Past it the
# offline judge answers — players still get a verdict and the bill has a roof.
# Default 120.
AI_CALLS_PER_MINUTE=

# Simultaneous WebSocket connections this instance will hold. Default 2000.
# Per-session is fixed at 12.
WS_MAX_CONNECTIONS=

# LOCAL REHEARSAL ONLY. `warn` lets the app start on a privileged database
# connection instead of refusing. It exists because a local PGlite database has
# only one role. Never set this in a real deployment — it turns off the check
# that keeps a bug in the authorization code from becoming a breach.
DB_ROLE_ENFORCEMENT=


# ===========================================================================
# 7. SUPABASE — the previous backend, kept until the Railway path is proven
# ===========================================================================
# Unused when NEXT_PUBLIC_WS_URL is set. Removed entirely at stage 14 of
# docs/RAILWAY-MIGRATION-PLAN.md.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Not required by anything in this application, and nothing added since needs
# it. Leave empty.
SUPABASE_SERVICE_ROLE_KEY=
